<UserControl x:Class="Pos_Client.etc.usercontrol.Cart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pos_Client.etc.usercontrol"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="340" FontWeight="Bold" FontSize="20">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition />
            <RowDefinition Height="50" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Margin="10" Text="장바구니" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

        <Border Grid.Row="1" BorderBrush="SkyBlue" BorderThickness="0,2,0,2" Padding="5" Width="330">
            
        </Border>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="합계" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="0" TextAlignment="Right" FontWeight="Bold"/>
        </Grid>
        
        <Button Grid.Row="3" Margin="10, 5, 10, 5" Content="주문하기" Background="Orange" FontWeight="Bold" />
    </Grid>
</UserControl>
