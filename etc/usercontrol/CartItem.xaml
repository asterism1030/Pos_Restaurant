<UserControl x:Class="Pos_Client.etc.usercontrol.CartItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pos_Client.etc.usercontrol"
             xmlns:uc="clr-namespace:Pos_Client.etc.usercontrol"
             mc:Ignorable="d" >
    <!--d:DesignHeight="80" d:DesignWidth="250">-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*" />
            <RowDefinition Height="15*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="8, 10, 0, 3" HorizontalAlignment="Left" VerticalAlignment="Center"
                   x:Name="name" Text="메뉴 이름" />

        <Border Grid.Row="1" BorderThickness="0, 0, 0, 1" BorderBrush="LightGray" Padding="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="8, 0, 90, 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       x:Name="price" Text="0" />

                <uc:QuantityButton Grid.Column="1"
                               x:Name="quantity_btn" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
