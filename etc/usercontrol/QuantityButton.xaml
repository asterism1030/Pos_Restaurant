<UserControl x:Class="Pos_Client.etc.usercontrol.QuantityButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pos_Client.etc.usercontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        
        <!-- TODO) 버튼 내부 글자가 아니라 이미지로 변경 -->
        <Button Grid.Column="0" x:Name="minus" Content=" - " Background="SkyBlue" BorderBrush="{x:Null}"
                Click="MinusBtn_Click" />

        <TextBlock Grid.Column="1" x:Name="quantity" Margin="10, 0, 10, 0" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="0" />

        <Button Grid.Column="2" x:Name="plus"  Content=" + " Background="SkyBlue" BorderBrush="{x:Null}"
                Click="PlusBtn_Click"/>
    </Grid>
</UserControl>
