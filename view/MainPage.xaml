<Page x:Class="Pos_Client.view.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pos_Client.view"
      xmlns:uc="clr-namespace:Pos_Client.etc.usercontrol"
      xmlns:vm="clr-namespace:Pos_Client.viewmodel"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="MainPage">

    <Page.DataContext>
        <vm:MainPageViewModel />
    </Page.DataContext>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <uc:TopBar Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="30*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#FFF6F6F6">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <!-- 메뉴 목록 -->
                    <ScrollViewer Grid.Row="0" Background="LightGray" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ListBox x:Name="menu_classification" ItemsSource="{Binding MenuList}"
                                 SelectedIndex = "{Binding SelectedListBoxIndex,Mode=TwoWay}"
                                 Background="#FFF6F6F6" BorderBrush="{x:Null}" BorderThickness="0">
                            <!-- 아이템 형식 지정-->
                            <ListBox.ItemTemplate>
                                <!-- 기본적으로 toString을 호출하므로(결과 값 StackPanel.MenuList() 쯤) DataTemplate 태그 사용 -->
                                <DataTemplate>
                                    <!-- TextBlock 의 높이 조정용 -->
                                    <StackPanel Orientation="Horizontal" Height="60">
                                        <TextBlock Text="{Binding Title}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="3"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Button Grid.Row="1" Margin="10, 5, 10, 5" Content="직원호출" Background="DarkGray" FontSize="15" BorderBrush="{x:Null}" />
                </Grid>

                <!-- TODO) 목록별 메뉴 리스트 페이지로 수정 예정 -->
                <Frame Grid.Column="1" x:Name="menu_main_frame" Focusable="False"
                        Source="{Binding MenuPageUri,Mode=TwoWay}" />
            </Grid>

        </Grid>

        <!-- 장바구니 -->
        <uc:Cart Grid.Column="1"/>
    </Grid>
</Page>
