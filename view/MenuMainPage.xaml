<Page x:Class="Pos_Client.view.MenuMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Pos_Client.view"
      xmlns:uc="clr-namespace:Pos_Client.etc.usercontrol"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="435"
      Title="MenuMainPage">

    <Grid Background="White" Margin="3" VerticalAlignment="Top">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <uc:MenuButton Grid.Column="0" Grid.Row="0" Margin="5, 10, 10, 10" x:Name="menu_1" />
                <uc:MenuButton Grid.Column="1" Grid.Row="0" Margin="10, 10, 5, 10" x:Name="menu_2" />

                <uc:MenuButton Grid.Column="0" Grid.Row="1" Margin="5, 10, 10, 10" x:Name="menu_3" />
                <uc:MenuButton Grid.Column="1" Grid.Row="1" Margin="10, 10, 5, 10" x:Name="menu_4" />

                <uc:MenuButton Grid.Column="0" Grid.Row="2" Margin="5, 10, 10, 10" x:Name="menu_5" />
                <uc:MenuButton Grid.Column="1" Grid.Row="2" Margin="10, 10, 5, 10" x:Name="menu_6" />
            </Grid>
        </ScrollViewer>
    </Grid>

</Page>
