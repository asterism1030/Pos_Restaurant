<Page x:Class="Pos_Client.view.MenuMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Pos_Client.view"
      xmlns:uc="clr-namespace:Pos_Client.etc.usercontrol"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="MenuMainPage">

    <Grid Background="White" Margin="5" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   x:Name="menu_title" Text="123456" FontSize="16" Foreground="White" Background="Black" />

        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" >
            <StackPanel >
                <uc:MenuArray x:Name="menu_array_1" />
                <uc:MenuArray x:Name="menu_array_2" />
                <uc:MenuArray x:Name="menu_array_3" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
